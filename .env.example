# Copy to .env (or .envrc with `export` in front of each line) for local runs.
# Both are gitignored. None of these are needed in CI: the action passes them in.

# Used by `review` when llm.provider is anthropic. Without it, review still runs
# but skips the LLM and reports rule-only verdicts.
ANTHROPIC_API_KEY=

# Used by `comment` and `fetch`. Falls back to GH_TOKEN, then to `gh auth token`.
GITHUB_TOKEN=

# owner/name of the repository to comment on, when not inferred from the git remote.
GITHUB_REPOSITORY=

# Used by `review` when llm.provider is jev.
TYPESAFE_API_KEY=

# Opt in to the eval suites: TFREVIEW_EVAL=1 runs the prose judge through the claude
# CLI, TFREVIEW_LIVE=1 the scoring judge against the real API.
TFREVIEW_EVAL=
TFREVIEW_EVAL_MODEL=
TFREVIEW_LIVE=
